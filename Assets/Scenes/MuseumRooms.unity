  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GreekSculpture
  sculptureName: "Disc\xF3bolo"
  baseTooltip: "El Disc\xF3bolo, atribuido a Mir\xF3n, representa al atleta en el
    instante\r\nprevio al lanzamiento del disco."
  renderersToHighlight: []
  highlightColor: {r: 1, g: 0.85, b: 0.4, a: 1}
  maxIntensity: 0.35
  outlineScale: 1.03
  transitionDuration: 0.18
  pose: 0
  sculptorOrCanon: "Mir\xF3n \u2014 per\xEDodo Cl\xE1sico"
  canonNote: "Ya no alcanza con distribuir el peso de otra forma: ahora el cuerpo\r\nentero
    se organiza alrededor de un instante de movimiento, torsi\xF3n\r\nm\xE1xima incluida.
    El canon no solo imita el cuerpo en reposo, sino\r\nque es capaz de congelar
    una acci\xF3n completa sin perder el equilibrio\r\nanat\xF3mico."
