  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GreekSculpture
  sculptureName: Kouros
  baseTooltip: "El Kouros, figura votiva o funeraria t\xEDpica del per\xEDodo Arcaico
    griego,\r\nheredera directa de las convenciones egipcias de representaci\xF3n
    del cuerpo."
  renderersToHighlight: []
  highlightColor: {r: 1, g: 0.85, b: 0.4, a: 1}
  maxIntensity: 0.35
  outlineScale: 1.03
  transitionDuration: 0.18
  pose: 0
  sculptorOrCanon: "Per\xEDodo Arcaico \u2014 sin atribuci\xF3n individual"
  canonNote: "Canon arcaico de frontalidad: simetr\xEDa estricta, peso repartido
    por igual\r\nen ambas piernas, brazos pegados al cuerpo. El esquema no busca
    el\r\nmovimiento real, solo se\xF1ala que la figura est\xE1 de pie y viva."
