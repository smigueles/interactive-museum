  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "C\xD3MO RECORRER EL MUSEO\r\n\r\nWASD \u2014 moverte por las salas\r\n\r\nMirar
    una pieza \u2014 se resalta y aparece el cursor activo, para que sepas que pod\xE9s
    interactuar con ella\r\n\r\nF (mantener apretada) \u2014 ver la informaci\xF3n
    de la pieza que est\xE1s mirando\r\n\r\nE \u2014 guardarla en tu bit\xE1cora\r\n\r\nTab
    \u2014 abrir tu bit\xE1cora, con todas las piezas que fuiste guardando en el
    recorrido\r\n\r\nQ \u2014 pausar en cualquier momento, o volver al men\xFA principal\r\n\r\nNo
    hace falta que guardes todo lo que ves: la bit\xE1cora es para lo que te llame
    la atenci\xF3n a vos."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
