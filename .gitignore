# This .gitignore file should be placed at the root of your Unity project directory
Library/
Temp/
Obj/
Build/
Builds/
Logs/
UserSettings/

# Memory dumps
*.apk
*.unitypackage
*.bundle

# Crashlytics generated file
sysinfo.pem

# Vector rasterization cache generated by Unity
.collabignore

# Assets that can be regenerated
AssetStoreTools*

# Autogenerated MSBuild and Visual Studio Project Files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crashlytics generated file
crashlytics-build.properties

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor / IDE
.vscode/
*.slnx
